# AI Video Generation - LLM Configuration
#
# This is an example configuration file. Copy this to .env and fill in your actual values.
# DO NOT commit .env file to version control.
#
# Usage:
#   1. Copy this file: cp config/example.env .env
#   2. Edit .env and fill in your API credentials
#   3. Load environment variables: source .env (bash/zsh) or set -a; source .env; set +a
#
# Security Note:
#   - Never commit API keys to Git
#   - Add .env to .gitignore
#   - Use environment variables only

# LLM Provider
# Options: openai_compatible, anthropic, custom
AI_VIDEO_LLM_PROVIDER=openai_compatible

# API Base URL
# For OpenAI: https://api.openai.com/v1
# For Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# For other OpenAI-compatible APIs: your custom endpoint
AI_VIDEO_LLM_BASE_URL=https://api.openai.com/v1

# Model Name
# Recommended: gpt-4o-mini (cost-effective for prompt generation)
# Alternative: gpt-4o, gpt-4-turbo, claude-3-5-sonnet
AI_VIDEO_LLM_MODEL=gpt-4o-mini

# API Key
# Get your API key from: https://platform.openai.com/api-keys
# IMPORTANT: Replace 'put_your_api_key_here' with your actual API key
AI_VIDEO_LLM_API_KEY=put_your_api_key_here

# Optional: Temperature (0.0 - 2.0)
# Lower = more deterministic, Higher = more creative
# Default: 0.7
# AI_VIDEO_LLM_TEMPERATURE=0.7

# Optional: Max tokens
# Maximum tokens to generate
# Default: 4096
# AI_VIDEO_LLM_MAX_TOKENS=4096

# Optional: Timeout (seconds)
# API call timeout
# Default: 60
# AI_VIDEO_LLM_TIMEOUT=60

# ----------------------------------------------------------------------
# v0.6.0 — APX Seedance Real Video Provider (optional, opt-in only)
# ----------------------------------------------------------------------
# When APX_VIDEO_ENABLED=true and APX_VIDEO_API_KEY is set, the Video Mode
# pipeline submits the v0.5.6 compiled Seedance prompt to the in-house APX
# async video gateway (doubao-seedance-2.0). Without these vars the system
# falls back to the offline MockVideoProvider — no real network calls.
#
# IMPORTANT:
#   - Never commit your real APX_VIDEO_API_KEY.
#   - The api-key is never written to the database, metadata exports,
#     or the Download All bundle.
#   - Real submit is refused on fallback assets unless you explicitly
#     set APX_VIDEO_ALLOW_FALLBACK_SUBMIT=true.

# Master switch. Leave unset / false to keep the system fully offline.
# APX_VIDEO_ENABLED=false

# APX gateway origin.
# APX_VIDEO_BASE_URL=http://apx-api.tal.com

# APX API key. Required when enabled. DO NOT commit a real value.
# APX_VIDEO_API_KEY=put_your_apx_api_key_here

# Underlying video model exposed by APX.
# APX_VIDEO_MODEL=doubao-seedance-2.0

# Submission knobs. v0.6.0 sends only {model, prompt, duration, prompt_extend}.
#
# APX_VIDEO_DURATION is the SINGLE SOURCE OF TRUTH for Video Mode duration.
# It propagates through:
#   - the asset pipeline target duration
#   - the LLM Video Asset Prompt template ({{DURATION_SECONDS}})
#   - storyboard.duration_seconds
#   - script.timing_plan / per-scene time_range
#   - seedance_prompt.txt "Duration: <N> seconds"
#   - seedance_payload_preview.json payload.duration_seconds
#   - the APX submit payload "duration"
#   - VideoJob.duration_seconds in the Video DB
#   - generation_manifest.json.target_duration_seconds + duration_synced
#
# Recommended values:
#   - 5  → smoke test (cheapest; APX bills by duration; ultra-short script)
#   - 30 → quality preview
#   - 60 → full educational short
#
# Restart the FastAPI server after changing this value so the asset
# pipeline picks up the new default.
# APX_VIDEO_DURATION=5
# APX_VIDEO_PROMPT_EXTEND=true

# Polling cadence and per-request HTTP timeout.
# APX_VIDEO_POLL_INTERVAL_SECONDS=5
# APX_VIDEO_TIMEOUT_SECONDS=600

# Optional: DELETE /v1/async/results/{id} after a successful download.
# APX_VIDEO_CONFIRM_AFTER_DOWNLOAD=false

# Optional override of the fallback-prompt safety guard. Default-deny.
# APX_VIDEO_ALLOW_FALLBACK_SUBMIT=false
